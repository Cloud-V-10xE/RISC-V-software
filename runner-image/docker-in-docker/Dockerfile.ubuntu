# GitHub Actions self-hosted runner for riscv64 — Ubuntu base, with
# docker-in-docker support (expects /var/run/docker.sock to be bind-mounted).
#
# RUNNER_URL and RUNNER_VERSION are supplied by the build workflow, which
# resolves them from the latest Cloud-V-10xE/github-runner-riscv release.
# They are deliberately NOT defaulted: a stale hardcoded version is exactly
# what this image is meant to avoid.
FROM docker.io/ubuntu:24.04

ARG RUNNER_VERSION
ARG RUNNER_URL

LABEL org.opencontainers.image.title="GitHub Actions Runner (RISC-V, docker-in-docker)" \
      org.opencontainers.image.description="Self-hosted GitHub Actions runner for linux/riscv64 with Docker support" \
      org.opencontainers.image.source="https://github.com/Cloud-V-10xE/RISC-V-software" \
      org.opencontainers.image.version="${RUNNER_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        libatomic1 docker.io curl git ca-certificates libicu-dev sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/runner

# Fail loudly if the build args were not passed, rather than producing an
# image with no runner in it.
RUN test -n "${RUNNER_URL}" || (echo "RUNNER_URL build-arg is required" >&2; exit 1) \
    && curl -fsSL --retry 3 --retry-delay 5 -o actions-runner.tar.gz "${RUNNER_URL}" \
    && tar xzf actions-runner.tar.gz \
    && rm actions-runner.tar.gz

RUN bash ./bin/installdependencies.sh

COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

RUN useradd -m runneruser \
    && chown -R runneruser:runneruser /home/runner \
    && echo "runneruser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/runneruser

# Intentionally stays root: the entrypoint has to align the container's docker
# group GID with the bind-mounted socket before dropping to runneruser.
ENTRYPOINT ["./entrypoint.sh"]
