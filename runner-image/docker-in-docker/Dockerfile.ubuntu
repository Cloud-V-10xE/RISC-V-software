# GitHub Actions self-hosted runner for riscv64 — Ubuntu base, Docker-capable.
#
# One image, two runtime modes (see entrypoint.sh, DOCKER_MODE):
#
#   host  docker-out-of-docker. /var/run/docker.sock is bind-mounted and jobs
#         drive the HOST daemon. Fast and shares the host layer cache, but any
#         job on this runner is root-equivalent on the host.
#   dind  true docker-in-docker. A private dockerd runs inside the container.
#         Needs --privileged (or SYS_ADMIN+NET_ADMIN) and a volume on
#         /var/lib/docker, and gives jobs no view of the host's daemon.
#
# Build context is runner-image/, not this directory — the registration script
# in common/ is shared with the unprivileged variant.
#
# RUNNER_URL and RUNNER_VERSION are supplied by the build workflow, which
# resolves them from the latest Cloud-V-10xE/github-runner-riscv release.
# They are deliberately NOT defaulted: a stale hardcoded version is exactly
# what this image is meant to avoid.
FROM docker.io/ubuntu:24.04

ARG RUNNER_VERSION
ARG RUNNER_URL
ARG RUNNER_SHA256=""

# Fixed ids, so a bind-mounted _work directory has predictable ownership on the
# host. 1000 is taken by the `ubuntu` user in the 24.04 base image.
ARG RUNNER_UID=1001
ARG RUNNER_GID=1001

# Passwordless sudo means a workflow can become root inside the container. That
# is required for jobs that apt-get install their own build deps, and it is much
# less dangerous in dind mode than in host mode. Set to false for a runner that
# takes untrusted workloads.
ARG RUNNER_SUDO=true

LABEL org.opencontainers.image.title="GitHub Actions Runner (RISC-V, Docker-capable)" \
      org.opencontainers.image.description="Self-hosted GitHub Actions runner for linux/riscv64 with docker-in-docker and docker-out-of-docker support" \
      org.opencontainers.image.source="https://github.com/Cloud-V-10xE/RISC-V-software" \
      org.opencontainers.image.version="${RUNNER_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive

# docker.io carries dockerd, the CLI, containerd and runc in one package — the
# same set serves both modes. iptables/uidmap/e2fsprogs are what the inner
# daemon needs for bridge networking and its own storage; util-linux provides
# setpriv and mountpoint, which the entrypoint relies on.
#
# noble-updates carries riscv64 builds of docker.io 29.x, docker-buildx and
# docker-compose-v2 — pulling those from apt keeps them signed by the archive
# and current, instead of curl-ing unverified release binaries from GitHub.
# (The noble release pocket alone is still on docker.io 24.0.7.)
#
# Explicit .NET runtime deps (libicu74 and friends) rather than libicu-dev: the
# headers are dead weight in a runtime image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        docker-buildx \
        docker-compose-v2 \
        docker.io \
        e2fsprogs \
        git \
        iptables \
        jq \
        libatomic1 \
        libicu74 \
        libkrb5-3 \
        liblttng-ust1 \
        libssl3 \
        procps \
        sudo \
        uidmap \
        util-linux \
        zlib1g \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && docker buildx version \
    && docker compose version

RUN groupadd -g "${RUNNER_GID}" runneruser \
    && useradd -m -u "${RUNNER_UID}" -g "${RUNNER_GID}" -s /bin/bash runneruser \
    && groupadd -f docker \
    && usermod -aG docker runneruser

WORKDIR /home/runner

# Fail loudly if the build args were not passed, rather than producing an
# image with no runner in it.
RUN set -eux; \
    test -n "${RUNNER_URL}" || { echo "RUNNER_URL build-arg is required" >&2; exit 1; }; \
    curl -fsSL --retry 3 --retry-delay 5 -o actions-runner.tar.gz "${RUNNER_URL}"; \
    if [ -n "${RUNNER_SHA256}" ]; then \
        echo "${RUNNER_SHA256}  actions-runner.tar.gz" | sha256sum -c -; \
    else \
        echo "note: RUNNER_SHA256 not supplied — tarball integrity not verified" >&2; \
    fi; \
    tar xzf actions-runner.tar.gz; \
    rm actions-runner.tar.gz

RUN bash ./bin/installdependencies.sh

COPY common/runner.sh /usr/local/bin/runner.sh
COPY docker-in-docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# Scripts are owned by root and not writable by runneruser: a job that can
# rewrite its own entrypoint keeps root across a container restart.
RUN set -eux; \
    chmod 0755 /usr/local/bin/runner.sh /usr/local/bin/entrypoint.sh; \
    chown root:root /usr/local/bin/runner.sh /usr/local/bin/entrypoint.sh; \
    chown -R runneruser:runneruser /home/runner; \
    if [ "${RUNNER_SUDO}" = "true" ]; then \
        echo "runneruser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/runneruser; \
        chmod 0440 /etc/sudoers.d/runneruser; \
    fi

# Anonymous volume by default: overlay2 cannot stack on an overlay2 upper dir,
# so without a real filesystem here the inner dockerd degrades to vfs and every
# build copies whole layers. Mount a named volume to keep the cache across
# restarts.
VOLUME /var/lib/docker

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD pgrep -f Runner.Listener >/dev/null || exit 1

# Intentionally stays root: the entrypoint has to prepare Docker access — align
# the container's docker group with a bind-mounted socket, or start the inner
# daemon — before dropping to runneruser via setpriv. It never returns to root.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
